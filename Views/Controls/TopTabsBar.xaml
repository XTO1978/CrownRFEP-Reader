<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="CrownRFEP_Reader.Views.Controls.TopTabsBar"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:behaviors="clr-namespace:CrownRFEP_Reader.Behaviors"
    xmlns:controls="clr-namespace:CrownRFEP_Reader.Views.Controls"
    xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls"
    BackgroundColor="#FF121212">

    <Grid>
        <!-- Row 0: barra del header -->
        <Grid x:Name="HeaderBar" Padding="10,0" ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="0" HeightRequest="50">
            <Button Grid.Column="0"
                    Text="Inicio"
                    Clicked="OnDashboardClicked"
                    BackgroundColor="Transparent"
                    TextColor="White"
                    FontFamily="{StaticResource AppFontBody}"
                    FontSize="{StaticResource FontSizeSubtitle}"
                    Padding="16,5" Margin="6"
                    CornerRadius="4">
                <Button.Behaviors>
                    <behaviors:HoverBackgroundBehavior />
                </Button.Behaviors>
            </Button>

            <Button Grid.Column="2"
                    Text="Gestión de base de datos"
                    Clicked="OnAthletesClicked"
                    BackgroundColor="Transparent"
                    TextColor="White"
                    FontFamily="{StaticResource AppFontBody}"
                    FontSize="{StaticResource FontSizeSubtitle}"
                    Padding="16,5"
                    Margin="6"
                    CornerRadius="4">
                <Button.Behaviors>
                    <behaviors:HoverBackgroundBehavior />
                </Button.Behaviors>
            </Button>

            <!-- Botón Ajustes -->
            <Border
                Grid.Column="4"
                x:Name="SettingsButton"
                BackgroundColor="Transparent"
                Stroke="Transparent"
                StrokeThickness="0"
                Padding="16,5" Margin="6">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnSettingsTapped" />
                </Border.GestureRecognizers>
                <Border.Behaviors>
                    <behaviors:HoverBackgroundBehavior />
                </Border.Behaviors>
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="4" />
                </Border.StrokeShape>
                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                    <Border WidthRequest="0.6" Margin="0,0,18,0" BackgroundColor="#FF232323" Stroke="#FF757575"/>
                    <controls:SymbolIcon
                        HeightRequest="18"
                        WidthRequest="18"
                        SymbolName="gearshape"
                        TintColor="#FFCCCCCC"
                        VerticalOptions="Center" />
                    <Label
                        Text="Ajustes"
                        TextColor="White"
                        FontFamily="{StaticResource AppFontBody}"
                        FontSize="{StaticResource FontSizeSubtitle}"
                        VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>

            <!-- Botón Perfil -->
            <Border
                Grid.Column="5"
                x:Name="ProfileButton"
                BackgroundColor="Transparent"
                Stroke="Transparent"
                StrokeThickness="0"
                Padding="16,5" Margin="6">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnProfileTapped" />
                </Border.GestureRecognizers>
                <Border.Behaviors>
                    <behaviors:HoverBackgroundBehavior />
                </Border.Behaviors>
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="4" />
                </Border.StrokeShape>

                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                    <Border WidthRequest="0.6" Margin="0,0,18,0" BackgroundColor="#FF232323" Stroke="#FF757575"/>
                    <Border
                        x:Name="ProfilePhotoBorder"
                        HeightRequest="26"
                        WidthRequest="26"
                        Padding="0"
                        BackgroundColor="#FF3A3A3A"
                        Stroke="#FF555555"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 999"
                        VerticalOptions="Center">
                        <Grid>
                            <Image
                                x:Name="ProfilePhotoImage"
                                Aspect="AspectFill"
                                IsVisible="False">
                                <Image.Clip>
                                    <shapes:EllipseGeometry Center="13,13" RadiusX="13" RadiusY="13" />
                                </Image.Clip>
                            </Image>
                        </Grid>
                    </Border>

                    <Label
                        x:Name="ProfileNameLabel"
                        Text="Yo"
                        TextColor="White"
                        FontFamily="{StaticResource AppFontBody}"
                        FontSize="{StaticResource FontSizeSubtitle}"
                        LineBreakMode="TailTruncation"
                        VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>
        </Grid>

        <!-- Overlay para cerrar el dropdown al tocar fuera -->
        <BoxView
            x:Name="SettingsDismissOverlay"
            IsVisible="False"
            BackgroundColor="Transparent"
            InputTransparent="False"
            TranslationY="50"
            HeightRequest="2000"
            VerticalOptions="Start"
            ZIndex="998">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnSettingsDismissTapped" />
            </BoxView.GestureRecognizers>
        </BoxView>

        <!-- Panel dropdown de Ajustes -->
        <Border
            x:Name="SettingsDropdownPanel"
            IsVisible="False"
            TranslationY="52"
            ZIndex="999"
            WidthRequest="280"
            HorizontalOptions="End"
            VerticalOptions="Start"
            Margin="0,0,20,0"
            Style="{StaticResource ContextMenuOverlayBorder}">
            <VerticalStackLayout Spacing="2">

                <!-- Separador: sección Apariencia -->
                <Label Text="APARIENCIA" FontSize="10" TextColor="#FF888888"
                       FontFamily="{StaticResource AppFontBody}" FontAttributes="Bold"
                       Margin="10,6,0,4" />

                <!-- Tema (claro/oscuro) -->
                <Border Style="{StaticResource ContextMenuItemBorder}">
                    <Border.Behaviors>
                        <behaviors:SidebarHoverBehavior />
                    </Border.Behaviors>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSettingsThemeTapped" />
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                        <controls:SymbolIcon
                            HeightRequest="18" WidthRequest="18"
                            SymbolName="moon.fill"
                            TintColor="#FFAAAAAA" VerticalOptions="Center" />
                        <Label Text="Tema claro / oscuro" Style="{StaticResource ContextMenuItemLabel}" />
                    </HorizontalStackLayout>
                </Border>

                <!-- Idioma -->
                <Border Style="{StaticResource ContextMenuItemBorder}">
                    <Border.Behaviors>
                        <behaviors:SidebarHoverBehavior />
                    </Border.Behaviors>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSettingsLanguageTapped" />
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                        <controls:SymbolIcon
                            HeightRequest="18" WidthRequest="18"
                            SymbolName="globe"
                            TintColor="#FFAAAAAA" VerticalOptions="Center" />
                        <Label Text="Idioma" Style="{StaticResource ContextMenuItemLabel}" />
                    </HorizontalStackLayout>
                </Border>

                <!-- Separador visual -->
                <BoxView HeightRequest="1" BackgroundColor="#FF3A3A3A" Margin="8,4" />

                <!-- Separador: sección Datos -->
                <Label Text="DATOS" FontSize="10" TextColor="#FF888888"
                       FontFamily="{StaticResource AppFontBody}" FontAttributes="Bold"
                       Margin="10,4,0,4" />

                <!-- Almacenamiento -->
                <Border Style="{StaticResource ContextMenuItemBorder}">
                    <Border.Behaviors>
                        <behaviors:SidebarHoverBehavior />
                    </Border.Behaviors>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSettingsStorageTapped" />
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                        <controls:SymbolIcon
                            HeightRequest="18" WidthRequest="18"
                            SymbolName="internaldrive"
                            TintColor="#FFAAAAAA" VerticalOptions="Center" />
                        <Label Text="Almacenamiento" Style="{StaticResource ContextMenuItemLabel}" />
                    </HorizontalStackLayout>
                </Border>

                <!-- Datos y backup -->
                <Border Style="{StaticResource ContextMenuItemBorder}">
                    <Border.Behaviors>
                        <behaviors:SidebarHoverBehavior />
                    </Border.Behaviors>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSettingsBackupTapped" />
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                        <controls:SymbolIcon
                            HeightRequest="18" WidthRequest="18"
                            SymbolName="arrow.clockwise.circle"
                            TintColor="#FFAAAAAA" VerticalOptions="Center" />
                        <Label Text="Datos y backup" Style="{StaticResource ContextMenuItemLabel}" />
                    </HorizontalStackLayout>
                </Border>

                <!-- Separador visual -->
                <BoxView HeightRequest="1" BackgroundColor="#FF3A3A3A" Margin="8,4" />

                <!-- Separador: sección Organización -->
                <Label Text="ORGANIZACIÓN" FontSize="10" TextColor="#FF888888"
                       FontFamily="{StaticResource AppFontBody}" FontAttributes="Bold"
                       Margin="10,4,0,4" />

                <!-- Administración org -->
                <Border Style="{StaticResource ContextMenuItemBorder}">
                    <Border.Behaviors>
                        <behaviors:SidebarHoverBehavior />
                    </Border.Behaviors>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSettingsAdminOrgTapped" />
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                        <controls:SymbolIcon
                            HeightRequest="18" WidthRequest="18"
                            SymbolName="building.2"
                            TintColor="#FFAAAAAA" VerticalOptions="Center" />
                        <Label Text="Administración de organización" Style="{StaticResource ContextMenuItemLabel}" />
                    </HorizontalStackLayout>
                </Border>

                <!-- Separador visual -->
                <BoxView HeightRequest="1" BackgroundColor="#FF3A3A3A" Margin="8,4" />

                <!-- Acerca de -->
                <Border Style="{StaticResource ContextMenuItemBorder}">
                    <Border.Behaviors>
                        <behaviors:SidebarHoverBehavior />
                    </Border.Behaviors>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSettingsAboutTapped" />
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                        <controls:SymbolIcon
                            HeightRequest="18" WidthRequest="18"
                            SymbolName="info.circle"
                            TintColor="#FFAAAAAA" VerticalOptions="Center" />
                        <Label Text="Acerca de CrownRFEP" Style="{StaticResource ContextMenuItemLabel}" />
                    </HorizontalStackLayout>
                </Border>

            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentView>
